    style=rounded; color="#94a3b8";
    "HYDRO_SET" [fillcolor="#fde68a", label="HYDRO_SET\nDedicated hydro_dock_pfd.png (graph-bridged); ca…"];
  }
  subgraph "cluster_WTR" {
    label="WTR";
    style=rounded; color="#94a3b8";
