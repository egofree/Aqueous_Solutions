  "CATCH_TANK" -> "ROOF_TANK" [label="IA-ESS-HYDRO-CHG\\n0.0 kg/d", style=dashed, color="#1b5e20", fontcolor="#1b5e20", penwidth=1.2];
  "ROOF_TANK" -> "CATCH_TANK" [label="IA-ESS-HYDRO-DIS\\n0.0 kg/d", style=dashed, color="#1b5e20", fontcolor="#1b5e20", penwidth=1.2];
  "HYDRO_SET" -> "SOL_ARK_60K" [label="IA-ESS-HYDRO-ELEC\\n0.0 kW", style=dashed, color="#1e3a8a", fontcolor="#1e3a8a", penwidth=1.2];
  "MEOH_SYNTH" -> "MEOH_TANK" [label="IA-ESS-MEOH-CHG", style=dashed, color="#1b5e20", fontcolor="#1b5e20", penwidth=1.2];
  "MEOH_FC" -> "SOL_ARK_60K" [label="IA-ESS-MEOH-DIS", style=dashed, color="#1e3a8a", fontcolor="#1e3a8a", penwidth=1.2];
  "SOL_ARK_60K" -> "ZNBR2" [label="IA-ESS-ZNBR2-CHG\\n6.6667 kW", style=dashed, color="#1e3a8a", fontcolor="#1e3a8a", penwidth=1.2];
  "ZNBR2" -> "SOL_ARK_60K" [label="IA-ESS-ZNBR2-DIS\\n5.0 kW", style=dashed, color="#1e3a8a", fontcolor="#1e3a8a", penwidth=1.2];
  "ROOF_TANK" -> "CATCH_TANK" [label="S22\\n0.0 kg/d", style=solid, color="#6d28d9", fontcolor="#6d28d9", penwidth=1.2];
  "CATCH_TANK" -> "ROOF_TANK" [label="S23\\n0.0 kg/d", style=solid, color="#6d28d9", fontcolor="#6d28d9", penwidth=1.2];
  "MEOH_TANK" -> "MEOH_FC" [label="S76\\n5.0 kg/d", style=solid, color="#1b5e20", fontcolor="#1b5e20", penwidth=2.2];
  "MEOH_FC" -> "SOL_ARK_60K" [label="S79\\n1.0 kW", style=solid, color="#1e3a8a", fontcolor="#1e3a8a", penwidth=2.2];
