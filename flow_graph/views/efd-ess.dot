digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, label="EFD ESS charge/discharge layer\nVIEW-EFD-ESS  ·  AQS-FLOW-GRAPH-001 rev BH", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.55];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8];
  subgraph "cluster_DOCK" {
    label="DOCK";
    style=rounded; color="#94a3b8";
    "BOUNDARY_EXPORT" [fillcolor="#fde68a", label="BOUNDARY_EXPORT\nDOCK export boundary — no inter-block S## for go…"];
  }
  subgraph "cluster_ELEC" {
    label="ELEC";
    style=rounded; color="#94a3b8";
    "SOL_ARK_60K" [fillcolor="#ffffff", label="SOL_ARK_60K"];
  }
  subgraph "cluster_ELEC_PV" {
    label="ELEC_PV";
    style=rounded; color="#94a3b8";
    "PV_ARRAY" [fillcolor="#ffffff", label="PV_ARRAY"];
  }
  subgraph "cluster_MEOH" {
    label="MEOH";
    style=rounded; color="#94a3b8";
    "MEOH_FC" [fillcolor="#ffffff", label="MEOH_FC"];
    "MEOH_TANK" [fillcolor="#ffffff", label="MEOH_TANK"];
  }
  subgraph "cluster_WTR" {
    label="WTR";
    style=rounded; color="#94a3b8";
    "CATCH_TANK" [fillcolor="#ffffff", label="CATCH_TANK"];
    "ROOF_TANK" [fillcolor="#ffffff", label="ROOF_TANK"];
  }
  subgraph "cluster_ZNBR2" {
    label="ZNBR2";
    style=rounded; color="#94a3b8";
    "ZNBR2" [fillcolor="#ffffff", label="ZNBR2"];
  }
  "CATCH_TANK" -> "ROOF_TANK" [label="IA-ESS-HYDRO-CHG\\n0.0 kg/d", style=dashed, color="#1b5e20", fontcolor="#1b5e20", penwidth=1.2];
  "ROOF_TANK" -> "CATCH_TANK" [label="IA-ESS-HYDRO-DIS\\n0.0 kg/d", style=dashed, color="#1b5e20", fontcolor="#1b5e20", penwidth=1.2];
  "PV_ARRAY" -> "SOL_ARK_60K" [label="IA-ESS-ZNBR2-SRC\\n1.6667 kW", style=dashed, color="#6d28d9", fontcolor="#6d28d9", penwidth=1.2];
  "SOL_ARK_60K" -> "ZNBR2" [label="IA-ESS-ZNBR2-CHG\\n6.6667 kW", style=dashed, color="#1e3a8a", fontcolor="#1e3a8a", penwidth=1.2];
  "ZNBR2" -> "SOL_ARK_60K" [label="IA-ESS-ZNBR2-DIS\\n5.0 kW", style=dashed, color="#1e3a8a", fontcolor="#1e3a8a", penwidth=1.2];
  "ROOF_TANK" -> "CATCH_TANK" [label="S22\\n0.0 kW", style=solid, color="#6d28d9", fontcolor="#6d28d9", penwidth=1.2];
  "CATCH_TANK" -> "ROOF_TANK" [label="S23\\n0.0 kW", style=solid, color="#6d28d9", fontcolor="#6d28d9", penwidth=1.2];
  "MEOH_TANK" -> "MEOH_FC" [label="S76\\n4.579141 kg/d", style=solid, color="#1b5e20", fontcolor="#1b5e20", penwidth=2.2];
  "ZNBR2" -> "BOUNDARY_EXPORT" [label="IA-ZNBR-LOSS\\n1.67 kW", style=solid, color="#1e3a8a", fontcolor="#1e3a8a", penwidth=1.2];
}
