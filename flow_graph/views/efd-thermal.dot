  "GEO_HP" -> "GROW_BED" [label="S06\\n1.5 kW", style=dashed, color="#b45309", fontcolor="#b45309", penwidth=1.2];
  "GEO_GHEX" -> "GEO_HP_CLOSED_LOOP" [label="S43\\n3.0 kW", style=dashed, color="#1b5e20", fontcolor="#1b5e20", penwidth=1.2];
