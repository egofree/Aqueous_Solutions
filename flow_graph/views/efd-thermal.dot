  }
  subgraph "cluster_MFG" {
    label="MFG";
    style=rounded; color="#94a3b8";
    "MET_HX_Q4" [fillcolor="#ffffff", label="MET_HX_Q4"];
  }
  subgraph "cluster_OIL" {
    label="OIL";
    style=rounded; color="#94a3b8";
