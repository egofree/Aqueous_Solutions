{
  "_about": "Data for flow_graph/check_doc_style.py, the light check of docs-authority/DOC_STYLE.md (AQS-DOC-002). banned: working jargon that a reader outside the project cannot follow, each with why it is banned and what to write instead (patterns are case-insensitive regular expressions matched against prose, with code removed). not_abbreviations: words written in capitals that are not abbreviations, such as signal words. long_abbreviations: abbreviations of six or more letters (longer capitalised tokens are otherwise read as words set in capitals). agent_only: paths that hold agent instructions and are not published pages. exempt: pages skipped by the check, each with its reason. pending: published pages not yet rewritten to the guide. Their findings do not fail the check. A page is removed by hand only after a genuine rewrite, not because it happens to pass; no page may be added.",
  "banned": [
    {
      "term": "agent box",
      "pattern": "\\bagent box\\b",
      "why": "the working machine used to produce a file",
      "instead": "name the tool and version, or say nothing"
    },
    {
      "term": "box (as a machine)",
      "pattern": "\\b(?:agent|operator|this|the build) box\\b|\\bbox (?:PDF|path)\\b|\\bon the box\\b",
      "why": "a working machine, not a reader's reference",
      "instead": "cite the published source"
    },
    {
      "term": "share tree / share path",
      "pattern": "\\bshare (?:tree|path|copy)\\b",
      "why": "a former shared working directory",
      "instead": "give the repository path"
    },
    {
      "term": "hub (as a working directory)",
      "pattern": "\\b(?:local|authority|the|or) hub\\b(?!\\s+(?:flange|bolt|motor|seal))|\\bhub (?:models|pfd_scripts|layout|bridged|sheets?)\\b",
      "why": "a former working directory",
      "instead": "give the repository path"
    },
    {
      "term": "worst-offender",
      "pattern": "\\bworst[- ]offender",
      "why": "task-tracking slang",
      "instead": "say which pages need which change"
    },
    {
      "term": "wave N",
      "pattern": "\\bwave [0-9]+\\b",
      "why": "a batch of work in a task list",
      "instead": "give the date, revision or task id"
    },
    {
      "term": "landed",
      "pattern": "\\blanded\\b",
      "why": "chat slang for committed or delivered",
      "instead": "say what was added and where"
    },
    {
      "term": "vouch",
      "pattern": "\\bvouch(?:es|ed|ing)?\\b",
      "why": "pipeline slang",
      "instead": "say what the receipt records"
    },
    {
      "term": "this session / per session",
      "pattern": "\\b(?:this|per|each|one) session\\b",
      "why": "refers to a working session",
      "instead": "say what is or is not available and why"
    },
    {
      "term": "the user",
      "pattern": "\\bthe user\\b(?!\\s+(?:interface|of the design tool))",
      "why": "an instruction addressed to an assistant",
      "instead": "name the role: the reader, the operator, the owner"
    },
    {
      "term": "re-derived",
      "pattern": "\\bre-derived\\b",
      "why": "pipeline slang",
      "instead": "say regenerated, or unchanged since"
    },
    {
      "term": "lane",
      "pattern": "\\b(?:closure|canonical|desk) lane\\b",
      "why": "task-tracking slang",
      "instead": "name the task or work group"
    },
    {
      "term": "as requested / per the owner",
      "pattern": "\\b(?:as requested|per the owner|the owner (?:said|asked|wants))\\b",
      "why": "records who asked, not why",
      "instead": "state the decision and its reason (OPEN_QUESTIONS.md)"
    }
  ],
  "not_abbreviations": [
    "WARNING",
    "CAUTION",
    "NOTE",
    "DANGER",
    "NOT",
    "AND",
    "OR",
    "ON",
    "OFF",
    "OK",
    "TODO",
    "DONE",
    "OPEN",
    "CLOSED",
    "LIVE",
    "HOLD",
    "TBD",
    "NA",
    "GET",
    "POST",
    "PUT",
    "PATCH",
    "DELETE"
  ],
  "long_abbreviations": [
    "ASHRAE",
    "PECVD",
    "LPCVD",
    "CERN-OHL"
  ],
  "agent_only": [
    "AGENTS.md",
    "docs-authority/internal/*",
    "docs-authority/notes/*"
  ],
  "exempt": [
    {
      "path": "docs-authority/DOC_STYLE.md",
      "reason": "The style guide quotes the banned terms as examples."
    },
    {
      "path": "CODE_OF_CONDUCT.md",
      "reason": "The Contributor Covenant text is adopted unchanged."
    }
  ],
