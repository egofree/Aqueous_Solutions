 "sector_use": {
  "_about": "A retired sector id that is also an ordinary word (WET bench, 40HC WET module) is stale only where it is used as a sector id. The patterns mark those uses; {id} stands for the sector id. Any other retired id is stale wherever it appears outside a line that states the history. A table row giving the retired id and then the sector that now holds it is the alias table itself and is allowed.",
  "word_ids": [
   "WET"
  ],
  "patterns": [
   "['\"]{id}['\"]",
   "\\| {id} \\|",
   "^#+ {id}\\s*$",
   "[Ss]ector[_ ]?(id)?[\\s:=`]+{id}\\b",
   "(?<![\\w)])\\({id}\\)",
   "\\b{id} (sector|line)\\b",
   "/ {id} polish"
  ],
  "history_words": "(?i:renamed|pre-rename|deleted|former|→|->|became|no longer|replaced|stale|removed)"
 },
